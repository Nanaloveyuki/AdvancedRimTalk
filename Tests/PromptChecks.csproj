    <Compile Include="ArtiPawnInfoChecks.cs" />
    <Compile Include="..\Source\Prompt\PromptSnapshot.cs" Link="PromptSnapshot.cs" />
    <Compile Include="..\Source\Prompt\PromptTemplateExpander.cs" Link="PromptTemplateExpander.cs" />
    <Compile Include="..\Source\Prompt\SystemInstructionRenderer.cs" Link="SystemInstructionRenderer.cs" />
    <Compile Include="..\Source\Arti\ArtiSyntax.cs" Link="ArtiSyntax.cs" />
    <Compile Include="..\Source\Arti\ArtiDiagnostics.cs" Link="ArtiDiagnostics.cs" />
    <Compile Include="..\Source\Arti\ArtiLexer.cs" Link="ArtiLexer.cs" />
    <Compile Include="..\Source\Arti\ArtiParser.cs" Link="ArtiParser.cs" />
    <Compile Include="..\Source\Arti\ArtiAnalyzer.cs" Link="ArtiAnalyzer.cs" />
    <Compile Include="..\Source\Arti\ArtiExecutor.cs" Link="ArtiExecutor.cs" />
    <Compile Include="..\Source\Arti\ArtiStringFunctions.cs" Link="ArtiStringFunctions.cs" />
    <Compile Include="..\Source\Arti\ArtiSymbols.cs" Link="ArtiSymbols.cs" />
    <Compile Include="..\Source\Arti\ArtiDocumentParser.cs" Link="ArtiDocumentParser.cs" />
    <Compile Include="..\Source\Integration\RimTalkArtiPawnAgeParts.cs" Link="RimTalkArtiPawnAgeParts.cs" />
    <Compile Include="..\Source\UI\ArtiEditorText.cs" Link="ArtiEditorText.cs" />
    <Compile Include="ArtiEditorTextChecks.cs" />
  </ItemGroup>
</Project>
