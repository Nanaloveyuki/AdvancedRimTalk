<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>AdvancedRimTalk</RootNamespace>
    <AssemblyName>AdvancedRimTalk</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>tmp\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">D:\Appdata\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManagedDir>
    <RimTalkAssemblyDir Condition="'$(RimTalkAssemblyDir)' == ''">F:\tmp\rimworld\Rimtalk\1.6\Assemblies</RimTalkAssemblyDir>
    <HarmonyAssemblyPath Condition="'$(HarmonyAssemblyPath)' == ''">F:\tmp\rimworld\RimIris\Assemblies\0Harmony.dll</HarmonyAssemblyPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**;tmp\**;obj\**" />
    <EmbeddedResource Include="docs\Arti\zh_cn\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimTalk">
      <HintPath>$(RimTalkAssemblyDir)\RimTalk.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Scriban">
      <HintPath>$(RimTalkAssemblyDir)\Scriban.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
